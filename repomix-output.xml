        colorPrefix = "\x1b[31;1m"
      } else if (pkg.riskLevel === "weak-copyleft") {
        badge = "🟡 WEAK COPYLEFT"
        colorPrefix = "\x1b[33m"
      } else if (pkg.riskLevel === "proprietary") {
        badge = "⚪ PROPRIETARY"
        colorPrefix = "\x1b[90m"
