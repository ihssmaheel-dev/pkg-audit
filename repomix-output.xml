        {
          name: "@repo/web",
          version: "1.0.0",
          relPath: "apps/web",
          absPath: path.join(webDir, "package.json"),
          isRoot: false,
          private: true,
          packageManager: null,
          enginesNode: null,
          depCount: 4,
          devCount: 1,
          deps: {
