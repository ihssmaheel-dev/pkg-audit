{
  "name": "pkg-audit",
  "version": "0.1.0",
  "description": "Scan JS/TS monorepos and open a local dashboard that makes dependency drift, hygiene, and outdated packages obvious.",
  "type": "module",
  "bin": {
    "pkg-audit": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/scan/index.d.ts",
      "default": "./dist/scan/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:ui": "tsx src/cli/index.ts --ui",
    "build": "npm run build:ts && npm run build:ui",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config src/web/vite.config.ts",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run verify"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "monorepo",
    "dependency",
    "audit",
    "drift",
    "workspaces",
    "package.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihssmaheel-dev/pkg-audit"
  },
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.4",
    "chart.js": "^4.5.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "preact": "^10.25.4",
    "prettier": "^3.4.2",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
