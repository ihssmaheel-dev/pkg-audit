      const prodTag = pkg.isProd ? " \x1b[31;1m[PROD]\x1b[0m" : " \x1b[90m[dev]\x1b[0m"
      console.log(`  ${colorPrefix}[${badge}]\x1b[0m ${pkg.name}@${pkg.version}${prodTag}`)
